{
  "name": "stitch2",
  "version": "0.5.0",
  "description": "A design canvas, layout and type checks, component consistency and screen versioning for agent-built UI, on Google's DESIGN.md format.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "stitch2": "dist/cli.js"
  },
  "exports": {
    "./elements": {
      "types": "./dist/elements.d.ts",
      "default": "./dist/elements.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "config.schema.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p . && node -e \"require('node:fs').copyFileSync('src/canvas.html','dist/canvas.html')\"",
    "typecheck": "tsc -p . --noEmit",
    "release": "node scripts/release.mjs",
    "prepublishOnly": "npm run build",
    "canvas": "node src/cli.ts canvas",
    "check": "node src/cli.ts check",
    "consistency": "node src/cli.ts consistency",
    "type": "node src/cli.ts type",
    "tokens": "node src/cli.ts tokens",
    "lint": "node src/cli.ts lint",
    "screens": "node src/cli.ts screens",
    "localize": "node src/cli.ts localize",
    "sandbox": "node src/cli.ts sandbox",
    "elements": "node src/cli.ts elements"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@google/design.md": "0.4.0",
    "@material/material-color-utilities": "0.3.0",
    "@playwright/test": "1.63.0",
    "yaml": "2.9.1",
    "esbuild": "0.28.2"
  },
  "keywords": [
    "design",
    "design-system",
    "design-md",
    "agents",
    "skills",
    "canvas",
    "ui",
    "stitch",
    "playwright"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ifokeev/stitch2.git"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "typescript": "7.0.2"
  },
  "private": true
}
