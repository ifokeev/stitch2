{
  "$schema": "../../config.schema.json",
  "name": "gymgym",
  "designDir": "design",
  "screenDirs": [
    "screens"
  ],
  "catalogDir": "screens/components",
  "prefix": "gg",
  "order": [
    "home",
    "plan",
    "routine-edit",
    "workout",
    "workout-summary",
    "exercises",
    "exercise-detail",
    "create-exercise-1",
    "create-exercise-2",
    "create-exercise-3",
    "stats",
    "history",
    "settings",
    "connect",
    "sign-in"
  ],
  "comfortableTarget": 32,
  "exports": [
    {
      "format": "dtcg",
      "path": "design/tokens.json"
    },
    {
      "format": "tailwind4",
      "path": "design/tokens.tailwind.css"
    }
  ]
}
